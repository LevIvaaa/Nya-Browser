{
  "name": "nya-browser",
  "version": "1.0.0",
  "description": "Nya Browser — быстрый и приватный браузер на Electron с вертикальными вкладками, автоскрытием интерфейса и встроенной блокировкой рекламы",
  "main": "./out/main/index.js",
  "author": "Nya",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node tests/filters.mjs && node tests/extensions.mjs",
    "dist:win": "electron-vite build && electron-builder --win --dir",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:installer": "electron-vite build && electron-builder --win nsis",
    "release": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.nya.browser",
    "productName": "Nya Browser",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "NyaBrowser-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "NyaBrowser-${version}-portable.exe",
      "unicode": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nya Browser",
      "artifactName": "NyaBrowser-${version}-setup.${ext}",
      "differentialPackage": true
    },
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "LevIvaaa",
      "repo": "Nya-Browser"
    },
    "afterPack": "build/afterPack.cjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.19",
    "electron": "github:castlabs/electron-releases#v43.2.0+wvcus",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "productName": "Nya Browser"
}
